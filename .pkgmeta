package-as: Postmortem

# A short, hand-written changelog. Without this the packager generates one
# from every commit since the previous non-alpha tag -- there is none, so
# that is the whole history (~200k characters), and GitHub rejects the
# release body with a 422 (its limit is 125,000). Seen on alpha-desktop-37.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The addon lives in addon/Postmortem/, not the repo root (this repo also
# holds the unrelated Python post-mortem tool). move-folders relocates it to
# become the package root -- the source path is package-as + the file's real
# repo-relative path, matching the exact pattern this session verified
# against EllesmereGaming/EllesmereUI's own real, currently-shipping
# .pkgmeta (a monorepo of several addons using this same mechanism).
move-folders:
  Postmortem/addon/Postmortem: Postmortem

# Everything else in this monorepo is the unrelated Python tool (or repo
# plumbing) and must not end up in the addon zip.
ignore:
  # Dev-only harnesses that live beside the addon but must never ship in
  # it -- addon/Postmortem is what move-folders promotes to the package
  # root, so anything else under addon/ would otherwise ride along.
  - addon/tests
  - src
  - scripts
  - build
  - site
  - tests
  - docs
  - data
  - pyproject.toml
  - README.md
  - ROADMAP.md
  - .gitignore
  - .github
  - .pytest_cache
